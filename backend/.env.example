# ------------------------------------------------------------------
# Real mode: fill everything below (see docs/guides/supabase-setup.md).
# Demo mode: leave Supabase/OpenAI keys empty — the backend falls back to
# local auth, hashed embeddings, and the extractive demo agent.
# ------------------------------------------------------------------

# --- Supabase (Auth + API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (Alembic + direct DB access) ---
# Supabase: use the DIRECT connection (db.<ref>.supabase.co), not the pooler.
# Local demo: postgresql://doccopilot:doccopilot@localhost:5432/document_copilot
DATABASE_URL=postgresql://doccopilot:doccopilot@localhost:5432/document_copilot

# --- OpenAI (LLM + embeddings) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_GROUNDING_MODEL=gpt-4.1-mini
OPENAI_AGENT_REQUEST_LIMIT=20
OPENAI_AGENT_TEMPERATURE=0

# --- Retrieval (hybrid search defaults) ---
RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_TOP_K=10
RETRIEVAL_RRF_K=60
RETRIEVAL_NEIGHBOR_RADIUS=1
RETRIEVAL_FTS_CONFIG=english
RETRIEVAL_FTS_KEYWORD_MIN=3
RETRIEVAL_FTS_KEYWORD_MAX=5
RETRIEVAL_FTS_KEYWORD_FAST_PATH_TOKENS=5

# --- Server ---
# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# --- Demo mode (optional explicit override; auto-detected when unset) ---
# DEMO_MODE=true
DEMO_JWT_SECRET=document-copilot-demo-secret-change-me
